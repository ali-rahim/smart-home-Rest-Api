{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "smart_home_Asp.net": "Debug",
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "Seq",
        "Args": {
          "serverUrl": "http://localhost:5341"
        }
      }
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "SmartHome": {
    "Name": "Ali Home",
    "AutomationEnabled": true
  },
  "Storage": {
    "Provider": "Json",
    "FilePath": "Data/smarthome.json",
    "AutoSave": true
  }
}